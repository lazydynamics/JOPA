# Generated run artifacts and model weights.
# Ignore the contents but keep the directories themselves in the tree.
outputs/*
!outputs/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# Model weights / replay buffers are large and are never committed,
# wherever they are written.
*.msgpack
*.npz
*.pkl

docs/index.html
previews/
figures/__pycache__/

# internal working notes, never committed
post.md
issues.md
